 FEXCore/Source/Interface/Core/JIT/ALUOps.cpp          |  7 +++++++
 FEXCore/Source/Interface/Core/JIT/JITClass.h          |  3 +++
 FEXCore/Source/Interface/Core/OpcodeDispatcher.cpp    |  6 ++++++
 .../IR/Passes/RedundantFlagCalculationElimination.cpp | 11 ++++++-----
 4 files changed, 22 insertions(+), 5 deletions(-)

