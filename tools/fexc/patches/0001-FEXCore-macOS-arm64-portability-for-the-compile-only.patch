From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Tue, 27 Oct 2026 00:00:00 +0000
Subject: [PATCH 1/6] FEXCore: macOS arm64 portability for the compile-only
 build

SpinWaitLock: size_t is `unsigned long` on macOS but uint64_t is
`unsigned long long`; add the missing LoadExclusive/WFELoadAtomic overloads.

AllocatorHooks: map JIT and dispatcher buffers without PROT_EXEC (macOS
arm64 refuses writable+executable anonymous maps; the output is only
exported, never run in-process), use posix_memalign because macOS
aligned_alloc rejects small alignments, and zero with memset in
VirtualDontNeed because macOS MADV_DONTNEED does not zero pages.

16 KiB host pages: guard pages and the temp code buffer are sized by
FEXC_HOST_PAGE_SIZE (tools/fexc/shim/fexc_compat.h) instead of the 4 KiB
guest page size FEX_PAGE_SIZE. Guest-page uses keep 4 KiB.
---
 FEXCore/Source/Interface/Core/JIT/JIT.cpp                 | 4 ++--
 FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp | 4 ++--
 FEXCore/Source/Utils/AllocatorHooks.cpp                   | 5 +++++
 FEXCore/include/FEXCore/Utils/AllocatorHooks.h            | 8 ++++++--
 FEXCore/include/FEXCore/Utils/SpinWaitLock.h              | 5 +++++
 FEXCore/include/FEXCore/Utils/ThreadPoolAllocator.h       | 4 ++--
 6 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index 514027e..dfef604 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -915,13 +915,13 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
 
   // Fairly excessive buffer range to make sure we don't overflow
   // One page baseline, plus SSANodeMultipler bytes, plus another page for guard page.
-  const uint32_t DesiredBufferRange = AlignUp(FEXCore::Utils::FEX_PAGE_SIZE * 2 + SSACount * SSANodeMultiplier, FEXCore::Utils::FEX_PAGE_SIZE);
+  const uint32_t DesiredBufferRange = AlignUp(FEXC_HOST_PAGE_SIZE * 2 + SSACount * SSANodeMultiplier, FEXC_HOST_PAGE_SIZE);
 
   // JIT output is first written to a temporary buffer and later relocated to the CodeBuffer.
   // This minimizes lock contention of CodeBufferWriteMutex.
   auto TempCodeBufferInfo = TempCodeBufferAllocator.ReownOrClaimBufferWithSize(DesiredBufferRange);
   auto TempCodeBuffer = TempCodeBufferInfo.Ptr;
-  const uint32_t UsableBufferRange = TempCodeBufferInfo.Size - FEXCore::Utils::FEX_PAGE_SIZE;
+  const uint32_t UsableBufferRange = TempCodeBufferInfo.Size - FEXC_HOST_PAGE_SIZE;
 
   SetBuffer(TempCodeBuffer, UsableBufferRange);
 
diff --git a/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp b/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp
index eee5023..f57d804 100644
--- a/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp
+++ b/FEXCore/Source/Interface/Core/SharedCodeBufferManager.cpp
@@ -22,8 +22,8 @@ CodeBuffer::CodeBuffer(size_t Size, bool ShouldBeNamed)
   LOGMAN_THROW_A_FMT(!!Ptr, "Couldn't allocate code buffer");
 
   // Protect the last page of the allocated buffer to trigger SIGSEGV on write access
-  uintptr_t LastPageAddr = AlignDown(reinterpret_cast<uintptr_t>(Ptr) + Size - 1, FEXCore::Utils::FEX_PAGE_SIZE);
-  if (!FEXCore::Allocator::VirtualProtect(reinterpret_cast<void*>(LastPageAddr), FEXCore::Utils::FEX_PAGE_SIZE,
+  uintptr_t LastPageAddr = AlignDown(reinterpret_cast<uintptr_t>(Ptr) + Size - 1, FEXC_HOST_PAGE_SIZE);
+  if (!FEXCore::Allocator::VirtualProtect(reinterpret_cast<void*>(LastPageAddr), FEXC_HOST_PAGE_SIZE,
                                           FEXCore::Allocator::ProtectOptions::None)) {
     LogMan::Msg::EFmt("Failed to mprotect last page of code buffer.");
   }
diff --git a/FEXCore/Source/Utils/AllocatorHooks.cpp b/FEXCore/Source/Utils/AllocatorHooks.cpp
index e85f09a..c21deba 100644
--- a/FEXCore/Source/Utils/AllocatorHooks.cpp
+++ b/FEXCore/Source/Utils/AllocatorHooks.cpp
@@ -229,7 +229,12 @@ size_t malloc_usable_size(void* ptr) {
   return ::malloc_usable_size(ptr);
 }
 void* aligned_alloc(size_t a, size_t s) {
+#ifdef __APPLE__
+  void* p = nullptr;
+  return ::posix_memalign(&p, a < sizeof(void*) ? sizeof(void*) : a, s ? s : 1) ? nullptr : p;
+#else
   return ::aligned_alloc(a, s);
+#endif
 }
 void aligned_free(void* ptr) {
   return ::free(ptr);
diff --git a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
index c4cadf4..76ceb67 100644
--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -114,18 +114,22 @@ FEX_DEFAULT_VISIBILITY extern void VirtualName(const char* Name, void* Ptr, size
 // All commit parameters are ignored here, they are unnecessary as Linux supports overcommit
 
 inline void* VirtualAlloc(size_t Size, bool Execute = false, bool Commit = true) {
-  return FEXCore::Allocator::mmap(nullptr, Size, PROT_READ | PROT_WRITE | (Execute ? PROT_EXEC : 0), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  return FEXCore::Allocator::mmap(nullptr, Size, PROT_READ | PROT_WRITE | FEXC_EXEC_PROT(Execute), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 }
 
 inline void* VirtualAlloc(void* Base, size_t Size, bool Execute = false, bool Commit = true) {
-  return FEXCore::Allocator::mmap(Base, Size, PROT_READ | PROT_WRITE | (Execute ? PROT_EXEC : 0), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  return FEXCore::Allocator::mmap(Base, Size, PROT_READ | PROT_WRITE | FEXC_EXEC_PROT(Execute), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 }
 
 inline void VirtualFree(void* Ptr, size_t Size) {
   FEXCore::Allocator::munmap(Ptr, Size);
 }
 inline void VirtualDontNeed(void* Ptr, size_t Size, bool Recommit = true) {
+#ifdef __APPLE__
+  memset(Ptr, 0, Size);
+#else
   ::madvise(reinterpret_cast<void*>(Ptr), Size, MADV_DONTNEED);
+#endif
 }
 inline bool VirtualProtect(void* Ptr, size_t Size, ProtectOptions options) {
   int prot {PROT_NONE};
diff --git a/FEXCore/include/FEXCore/Utils/SpinWaitLock.h b/FEXCore/include/FEXCore/Utils/SpinWaitLock.h
index af59a6e..84b650e 100644
--- a/FEXCore/include/FEXCore/Utils/SpinWaitLock.h
+++ b/FEXCore/include/FEXCore/Utils/SpinWaitLock.h
@@ -129,6 +129,11 @@ static inline uint64_t WFELoadAtomic(uint64_t* Futex) {
   return Result;
 }
 
+#ifdef __APPLE__
+static inline unsigned long LoadExclusive(unsigned long* Futex) { return LoadExclusive(reinterpret_cast<uint64_t*>(Futex)); }
+static inline unsigned long WFELoadAtomic(unsigned long* Futex) { return WFELoadAtomic(reinterpret_cast<uint64_t*>(Futex)); }
+#endif
+
 template<typename Pred, typename T>
 static inline void WaitPred(T* Futex, T ComparisonValue) {
   auto AtomicFutex = std::atomic_ref<T>(*Futex);
diff --git a/FEXCore/include/FEXCore/Utils/ThreadPoolAllocator.h b/FEXCore/include/FEXCore/Utils/ThreadPoolAllocator.h
index 69e410c..65bdec9 100644
--- a/FEXCore/include/FEXCore/Utils/ThreadPoolAllocator.h
+++ b/FEXCore/include/FEXCore/Utils/ThreadPoolAllocator.h
@@ -420,8 +420,8 @@ public:
 private:
   void* Alloc(size_t Size) override {
     auto Ptr = FEXCore::Allocator::VirtualAlloc(Size);
-    uintptr_t LastPageAddr = AlignDown(reinterpret_cast<uintptr_t>(Ptr) + Size - 1, FEXCore::Utils::FEX_PAGE_SIZE);
-    if (!FEXCore::Allocator::VirtualProtect(reinterpret_cast<void*>(LastPageAddr), FEXCore::Utils::FEX_PAGE_SIZE,
+    uintptr_t LastPageAddr = AlignDown(reinterpret_cast<uintptr_t>(Ptr) + Size - 1, FEXC_HOST_PAGE_SIZE);
+    if (!FEXCore::Allocator::VirtualProtect(reinterpret_cast<void*>(LastPageAddr), FEXC_HOST_PAGE_SIZE,
                                             FEXCore::Allocator::ProtectOptions::None)) {
       LogMan::Msg::EFmt("Failed to mprotect last page of code buffer.");
     }
