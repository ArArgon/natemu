From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH 22/22] FEXCore: slice1 I8 review: HADD order, UNORD flags,
 upper-half cache

Under fexc_slice1 only.

- Vector.cpp VectorALUOp / AVX_128.cpp AVX128_VHADDP: HADDPS/HADDPD and their
  VEX forms add each pair high element first (SDM: DEST[63:0] := SRC1[127:64]
  + SRC1[63:0]): UZP2 + UZP1 instead of FADDP (low first), so two NaNs give
  the high one under the first-source rule.
- Vector.cpp VFCMPOpImpl/InsertScalarFCMPOpImpl: UNORD_Q/ORD_Q (3, 7) take
  the exact-flag path too (FEX's fcmge/fcmgt raised IE for a QNaN); that
  path finds unordered lanes by integer compares of |x| with infinity (no
  flag) and takes the flags from one fcmeq/fcmge of the operands (x86's
  precedence: no DE beside a NaN).
- OpcodeDispatcher.h/Core.cpp: the YMM upper halves are written through at
  every instruction start and stay cached across a register-only vector
  instruction (at most 6), instead of a store and reload per instruction;
  one STR each (no STP pairing).
---
diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 3ce4ce8..101f450 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -649,7 +649,18 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
         // It is potentially correctness bearing in that sense, but that is a
         // side effect here and (if that behaviour is required) we should handle
         // that more explicitly later.
+        // natemu slice1 (I8 review): every instruction starts with the YMM upper halves its predecessors wrote stored, so the
+        // state at each fault and exit is exact; across a register-only vector instruction (VEX or SSE map, no memory
+        // operand: it can neither fault nor exit) they also stay cached (write-through), so a dependent chain is not a
+        // store and reload per instruction. At most 6 stay cached (no spill).
+        if (fexc_slice1) {
+          const uint8_t M = DecodedInfo->FexcMap;
+          Thread->OpDispatcher->FexcKeepAVXHigh = (M == FEXC_MAP_VEX || (M >= FEXC_MAP_TWO && M <= FEXC_MAP_0F3A)) &&
+                                                  !Thread->OpDispatcher->CanHaveSideEffects(TableInfo, DecodedInfo) &&
+                                                  Thread->OpDispatcher->FexcCachedAVXHigh() <= 6;
+        }
         Thread->OpDispatcher->FlushRegisterCache(true);
+        Thread->OpDispatcher->FexcKeepAVXHigh = false;
 
         if (ExtendedDebugInfo || Thread->OpDispatcher->CanHaveSideEffects(TableInfo, DecodedInfo)) {
           fexc_cf_inverted[InstAddress - GuestRIP] = Thread->OpDispatcher->FexcCFInverted();
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index 544c250..6f91170 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1179,6 +1179,12 @@ public:
     _StoreContext(Size, Class, Value, Offset);
   }
 
+  // natemu slice1 (I8 review): the next per-instruction flush stores the written YMM upper halves but keeps them cached
+  // (Core.cpp sets it for a register-only vector instruction), and how many are cached now.
+  bool FexcKeepAVXHigh = false;
+  int FexcCachedAVXHigh() const {
+    return std::popcount(RegCache.Cached & (((1ull << (AVXHigh15Index - AVXHigh0Index + 1)) - 1) << AVXHigh0Index));
+  }
   void FlushRegisterCache(bool SRAOnly = false, bool MMXOnly = false) {
     // At block boundaries, fix up the carry flag.
     if (!SRAOnly) {
@@ -1200,6 +1206,7 @@ public:
     // We have an SRA only mode that exists as a hack to make register caching
     // less aggressive. We should get rid of this once RA can take it.
     uint64_t Mask = ~0ULL;
+    uint64_t Keep = 0;   // natemu: written back but still cached
 
     if (SRAOnly) {
       const uint64_t GPRMask = ((1ull << (AFIndex - GPR0Index + 1)) - 1) << GPR0Index;
@@ -1211,6 +1218,9 @@ public:
       // fault reports): each instruction stores the ones it wrote, so no write is dropped (VZEROUPPER's invalidation) or sunk.
       const uint64_t AVXHighMask = ((1ull << (AVXHigh15Index - AVXHigh0Index + 1)) - 1) << AVXHigh0Index;
       Mask &= (GPRMask | FPRMask | (fexc_slice1 ? (1ull << DFIndex) | AVXHighMask : 0));
+      // (I8 review: before a register-only vector instruction, FexcKeepAVXHigh (Core.cpp), the stored upper halves stay
+      // cached too, so the next one reads its register instead of reloading what was just stored: write-through.)
+      if (FexcKeepAVXHigh) Keep = AVXHighMask;
       Bits &= Mask;
     }
 
@@ -1247,7 +1257,9 @@ public:
         // TODO: this is all really confusing because of backwards iteration,
         // can we peel back that hack?
         const auto SizeInt = IR::OpSizeToSize(Size);
+        // natemu slice1 (I8 review): no STP for the YMM upper halves (one STR each, as a later single LDR reads them).
         if ((Bits & NextBit) && !Partial && Size >= OpSize::i32Bit && CacheIndexToContextOffset(Index - 1) == Offset - SizeInt &&
+            !(fexc_slice1 && Index >= AVXHigh0Index) &&
             (Offset - SizeInt) / SizeInt < 64) {
           LOGMAN_THROW_A_FMT(CacheIndexClass(Index - 1) == Class, "construction");
           LOGMAN_THROW_A_FMT((Offset % SizeInt) == 0, "construction");
@@ -1268,8 +1280,8 @@ public:
     }
 
     RegCache.Written &= ~Mask;
-    RegCache.Cached &= ~Mask;
-    RegCache.Partial &= ~Mask;
+    RegCache.Cached &= ~(Mask & ~Keep);
+    RegCache.Partial &= ~(Mask & ~Keep);
   }
 
   IR::OpSize GetGPROpSize() const {
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
index 6fa6893..38037ee 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
@@ -1482,8 +1482,11 @@ void OpDispatchBuilder::AVX128_VPERMILImm(OpcodeArgs, IR::OpSize ElementSize) {
 
 void OpDispatchBuilder::AVX128_VHADDP(OpcodeArgs, IROps IROp, IR::OpSize ElementSize) {
   AVX128_VectorBinaryImpl(Op, OpSizeFromSrc(Op), ElementSize, [&](IR::OpSize ElementSize, Ref Src1, Ref Src2) {
+    if (fexc_slice1 && IROp == OP_VFADDP) {   // natemu slice1 (I8 review): VHADDPS/VHADDPD high element first, as HADDP (Vector.cpp)
+      return Ref(_VFAdd(OpSize::i128Bit, ElementSize, _VUnZip2(OpSize::i128Bit, ElementSize, Src1, Src2), _VUnZip(OpSize::i128Bit, ElementSize, Src1, Src2)));
+    }
     DeriveOp(Res, IROp, _VFAddP(OpSize::i128Bit, ElementSize, Src1, Src2));
-    return Res;
+    return Ref(Res);
   });
 }
 
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
index 288a131..3b8e02c 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/Vector.cpp
@@ -289,6 +289,13 @@ void OpDispatchBuilder::VectorALUOp(OpcodeArgs, IROps IROp, IR::OpSize ElementSi
   Ref Src = LoadSourceFPR(Op, Op->Src[0], Op->Flags);
   Ref Dest = LoadSourceFPR(Op, Op->Dest, Op->Flags);
 
+  if (fexc_slice1 && IROp == OP_VFADDP) {
+    // natemu slice1 (I8 review): HADDPS/HADDPD add each pair high element first (SDM: DEST[63:0] := SRC1[127:64] +
+    // SRC1[63:0]), so with two NaNs the first-source rule (Vol.1 Table 4-7) returns the high one; Arm's FADDP adds low first.
+    Ref Sum = _VFAdd(Size, ElementSize, _VUnZip2(Size, ElementSize, Dest, Src), _VUnZip(Size, ElementSize, Dest, Src));
+    StoreResult_WithAVXInsert(VectorOpType::SSE, RegClass::FPR, Op, Sum);
+    return;
+  }
   DeriveOp(ALUOp, IROp, _VAdd(Size, ElementSize, Dest, Src));
 
   StoreResult_WithAVXInsert(VectorOpType::SSE, RegClass::FPR, Op, ALUOp);
@@ -531,8 +538,9 @@ void OpDispatchBuilder::AVXInsertScalarRound(OpcodeArgs, IR::OpSize ElementSize)
 
 Ref OpDispatchBuilder::InsertScalarFCMPOpImpl(OpSize Size, IR::OpSize OpDstSize, IR::OpSize ElementSize, Ref Src1, Ref Src2,
                                               uint8_t CompType, bool ZeroUpperBits) {
-  // natemu slice1 (I8): VCMPSS/VCMPSD with an AVX predicate: the packed form's exact flags on the low element (VFCMPOpImpl).
-  if (fexc_slice1 && CompType >= 8 && !ZeroUpperBits) {
+  // natemu slice1 (I8): VCMPSS/VCMPSD with an AVX predicate, and (I8 review) CMPSS/CMPSD/VCMPSS/VCMPSD UNORD_Q/ORD_Q: the
+  // packed form's exact flags on the low element (VFCMPOpImpl).
+  if (fexc_slice1 && (CompType >= 8 || (CompType & 3) == 3) && !ZeroUpperBits) {
     return _VInsElement(OpDstSize, ElementSize, 0, 0, Src1, VFCMPOpImpl(ElementSize, ElementSize, Src1, Src2, CompType));
   }
   switch (static_cast<VectorCompareType>(CompType)) {
@@ -2902,24 +2910,27 @@ void OpDispatchBuilder::MOVBetweenGPR_FPR(OpcodeArgs, VectorOpType VectorType) {
 }
 
 Ref OpDispatchBuilder::VFCMPOpImpl(OpSize Size, IR::OpSize ElementSize, Ref Src1, Ref Src2, uint8_t CompType, bool FexcInner) {
-  if (fexc_slice1 && CompType >= 8 && !FexcInner) {
+  // (I8 review: also UNORD_Q/ORD_Q, 3 and 7, legacy CMPPS/CMPPD's too: FEX lowers them to fcmge/fcmgt, IE for a QNaN.)
+  if (fexc_slice1 && (CompType >= 8 || (CompType & 3) == 3) && !FexcInner) {
     // natemu slice1 (I8): the AVX predicates 8..31 with x86's MXCSR flags (SDM Vol.2 CMPPS, Table 3-1: "Signals #IA on
     // QNAN"). FEX lowers each to fcmeq (quiet) or fcmgt/fcmge (signalling) whatever the predicate says, and FALSE/TRUE to a
-    // constant (no flag at all). Here: Ordered from two quiet fcmeq (IE for an SNaN, DE for a denormal: every predicate),
-    // FEX's lowering on the operands with their unordered lanes zeroed (no NaN reaches a signalling compare), then the
-    // predicate's unordered value, and for a signalling predicate one fcmge of the operands (IE for a QNaN) whose all-zero
+    // constant (no flag at all). Here: FEX's lowering on the operands with their unordered lanes zeroed (no NaN reaches a
+    // signalling compare), then the predicate's unordered value, and one compare of the operands for the flags: fcmeq for a
+    // quiet predicate (IE for an SNaN), fcmge for a signalling one (IE for a QNaN too), DE with x86's precedence; its all-zero
     // contribution keeps it live.
     const uint8_t C = CompType & 15;
     const bool Unordered = C == 3 || C == 4 || C == 5 || C == 6 || C == 8 || C == 9 || C == 10 || C == 15;
     const bool Signalling = (C == 1 || C == 2 || C == 5 || C == 6 || C == 9 || C == 10 || C == 13 || C == 14) != (CompType >= 16);
-    Ref Ordered = _VAnd(Size, _VFCMPEQ(Size, ElementSize, Src1, Src1), _VFCMPEQ(Size, ElementSize, Src2, Src2));
+    // (I8 review: Ordered by integer compares of |x| against infinity, which raise no flag; the one flag op, fcmeq for a quiet
+    // predicate or fcmge for a signalling one, then gives x86's precedence too: no DE beside a NaN operand.)
+    const auto IntSize = Size == OpSize::i128Bit ? Size : OpSize::i64Bit;   // a scalar form: its low 64 bits (integer ops)
+    Ref Inf = _VDupFromGPR(IntSize, ElementSize, Constant(ElementSize == OpSize::i32Bit ? 0x7f800000ULL : 0x7ff0000000000000ULL));
+    auto Nan = [&](Ref V) { return _VCMPGT(IntSize, ElementSize, _VUShrI(IntSize, ElementSize, _VShlI(IntSize, ElementSize, V, 1), 1), Inf); };
+    Ref Ordered = _VNot(IntSize, _VOr(IntSize, Nan(Src1), Nan(Src2)));
     Ref Result = _VAnd(Size, VFCMPOpImpl(Size, ElementSize, _VAnd(Size, Src1, Ordered), _VAnd(Size, Src2, Ordered), CompType, true), Ordered);
     if (Unordered) Result = _VOr(Size, Result, _VNot(Size, Ordered));
-    if (Signalling) {
-      Ref Flag = _VFCMPLE(Size, ElementSize, Src1, Src2);
-      Result = _VOr(Size, Result, _VAnd(Size, Flag, _VNot(Size, Flag)));
-    }
-    return Result;
+    Ref Flag = Signalling ? _VFCMPLE(Size, ElementSize, Src1, Src2) : _VFCMPEQ(Size, ElementSize, Src1, Src2);
+    return _VOr(Size, Result, _VAnd(Size, Flag, _VNot(Size, Flag)));
   }
   switch (static_cast<VectorCompareType>(CompType)) {
   case VectorCompareType::EQ_OQ:
