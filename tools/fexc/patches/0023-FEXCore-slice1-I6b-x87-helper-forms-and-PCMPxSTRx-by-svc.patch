From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH 23/23] FEXCore: slice1 I6b: x87 helper forms and PCMPxSTRx by
 svc

Under fexc_slice1 only. No host helper: the resident runs these (the
division precedent); the shim (tools/fexc/shim/fexc_sites.inc) emits the
svc sequences.

- IR.json: FexcX87Svc u8:$Function (side effects, JIT-dispatched).
- X87.cpp X87OpHelper (F2XM1 FPTAN FPATAN FPREM1 FPREM FSINCOS FSCALE FSIN
  FCOS only, not FCHS FABS FSQRT FRNDINT) and X87FYL2X, X87F64.cpp
  X87FXTRACTF64: the whole instruction is one FexcX87Svc of the D9 opcode's
  second byte (`movz w0, #fn; svc #5`), on the x87 state the stack pass
  leaves in the guest-state page at every instruction boundary.
- JIT.cpp Op_Unhandled: VPCMPISTRX/VPCMPESTRX call FexcStringSvc (v0, v1,
  x1 = RAX, x2 = RDX, `movz w0, #control; svc #6`) instead of FEX's
  host helper.
---
diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index 7345558..04fd986 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -466,6 +466,10 @@ void Arm64JITCore::Op_Unhandled(const IR::IROp_Header* IROp, IR::Ref Node) {
     } break;
 
     case FABI_I32_I64_I64_V128_V128_I16: {
+      if (fexc_slice1) { // natemu slice1 (I6b): the resident's string compare (svc #STRING), no host helper
+        FexcStringSvc(IROp, Node);
+        break;
+      }
       // Linux Reg/Win32 Reg:
       // stack: FallbackHandler
       // x30: return
@@ -500,6 +504,10 @@ void Arm64JITCore::Op_Unhandled(const IR::IROp_Header* IROp, IR::Ref Node) {
       FillI32Result();
     } break;
     case FABI_I32_V128_V128_I16: {
+      if (fexc_slice1) { // natemu slice1 (I6b): as above
+        FexcStringSvc(IROp, Node);
+        break;
+      }
       // Linux Reg/Win32 Reg:
       // tmp4 (x4/x13): FallbackHandler
       // x30: return
diff --git a/FEXCore/Source/Interface/Core/JIT/JITClass.h b/FEXCore/Source/Interface/Core/JIT/JITClass.h
index 59ff10d..0daf46d 100644
--- a/FEXCore/Source/Interface/Core/JIT/JITClass.h
+++ b/FEXCore/Source/Interface/Core/JIT/JITClass.h
@@ -560,6 +560,8 @@ private:
   bool FexcX87Op(const IR::IROp_Header* IROp);
   void FexcX87Begin();
   void FexcX87End();
+  // natemu (fexc), profile slice1 (I6b): PCMPxSTRx's intermediate result by the resident's `svc #STRING` (shim/fexc_sites.inc).
+  void FexcStringSvc(const IR::IROp_Header* IROp, IR::Ref Node);
   bool FexcRoundBegin(IR::RoundMode Mode);
   void FexcRoundEnd(IR::RoundMode Mode);
   uint32_t FexcNegLoad {};
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
index 127967c..4932c56 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87.cpp
@@ -624,6 +624,10 @@ void OpDispatchBuilder::FXCH(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::X87FYL2X(OpcodeArgs, bool IsFYL2XP1) {
+  if (fexc_slice1) {
+    _FexcX87Svc(Op->OP & 0xff);   // natemu slice1 (I6b): as X87OpHelper
+    return;
+  }
   if (IsFYL2XP1) {
     _F80FYL2XP1Stack();
   } else {
@@ -715,6 +719,17 @@ void OpDispatchBuilder::FTST(OpcodeArgs) {
 }
 
 void OpDispatchBuilder::X87OpHelper(OpcodeArgs, FEXCore::IR::IROps IROp, bool ZeroC2) {
+  using enum FEXCore::IR::IROps;
+  const bool Helper = IROp == OP_F80F2XM1STACK || IROp == OP_F80PTANSTACK || IROp == OP_F80ATANSTACK || IROp == OP_F80FPREM1STACK ||
+                      IROp == OP_F80FPREMSTACK || IROp == OP_F80SINCOSSTACK || IROp == OP_F80SCALESTACK || IROp == OP_F80SINSTACK ||
+                      IROp == OP_F80COSSTACK;   // not FCHS, FABS, FSQRT, FRNDINT (native code)
+  if (fexc_slice1 && Helper) {
+    // natemu slice1 (I6b): the transcendental, remainder and scale forms run whole in the resident (svc #X87, the D9 opcode's
+    // second byte), on the x87 state the stack pass leaves in the guest-state page at every instruction boundary: the x87 rules
+    // FEX's F64 helpers lack (C2 out of range, FPREM's quotient bits and partial remainder, stack faults, the exception word).
+    _FexcX87Svc(Op->OP & 0xff);
+    return;
+  }
   DeriveOp(Result, IROp, _F80SCALEStack());
   if (ZeroC2) {
     SetRFLAG<FEXCore::X86State::X87FLAG_C2_LOC>(Constant(0));
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp
index cfa27e4..f254e28 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/X87F64.cpp
@@ -431,6 +431,10 @@ void OpDispatchBuilder::FCOMIF64(OpcodeArgs, IR::OpSize Width, bool Integer, OpD
 }
 
 void OpDispatchBuilder::X87FXTRACTF64(OpcodeArgs) {
+  if (fexc_slice1) {
+    _FexcX87Svc(Op->OP & 0xff);   // natemu slice1 (I6b): as X87OpHelper (a denormal double splits exactly there)
+    return;
+  }
   // Split node into SIG and EXP while handling the special zero case.
   // i.e. if val == 0.0, then sig = 0.0, exp = -inf
   // if val == -0.0, then sig = -0.0, exp = -inf
diff --git a/FEXCore/Source/Interface/IR/IR.json b/FEXCore/Source/Interface/IR/IR.json
index 2d850dd..8812678 100644
--- a/FEXCore/Source/Interface/IR/IR.json
+++ b/FEXCore/Source/Interface/IR/IR.json
@@ -2896,6 +2896,12 @@
         "DestSize": "OpSize::i64Bit",
         "JITDispatch": true
       },
+      "FexcX87Svc u8:$Function": {
+        "Desc": ["natemu slice1 (I6b): the x87 instruction D9 $Function (F2XM1 FYL2X FPTAN FPATAN FXTRACT FPREM1 FPREM FYL2XP1",
+                 "FSINCOS FSCALE FSIN FCOS) run whole by the resident on the x87 state in the guest-state page (svc #X87)"
+                ],
+        "HasSideEffects": true
+      },
       "FPR:$Sin, FPR:$Cos = F64SINCOS FPR:$Src": {
         "DestSize": "OpSize::i64Bit",
         "HasSideEffects": true,
