From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Tue, 27 Oct 2026 00:00:00 +0000
Subject: [PATCH 2/6] FEXCore: guest-code window seam

Guest instruction bytes live in a bounded host buffer that the driver
resolves by logical guest address, so nothing is mapped at the guest
address. Add SyscallHandler::ResolveGuestCodePointer (default: return the
fallback), call it from Frontend (byte and multi-byte instruction fetch)
and Core (disassembly and existing-code comparison), and turn every
pointer arithmetic on guest PCs into integer arithmetic so an
upper-canonical RIP never dereferences host memory. A null result means
"not executable". Ported from tools/i4v_producer/adapt.py.
---
 FEXCore/Source/Interface/Core/Core.cpp       |  6 ++++--
 FEXCore/Source/Interface/Core/Frontend.cpp   | 18 +++++++++++-------
 FEXCore/Source/Interface/Core/Frontend.h     |  8 ++++----
 FEXCore/include/FEXCore/HLE/SyscallHandler.h |  6 ++++++
 4 files changed, 25 insertions(+), 13 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 8795e83..46c0d30 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -611,7 +611,8 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
 
 #ifdef ZYDIS_DISASSEMBLER
         if (FEXCore::Config::Get_X86DISASSEMBLE()) {
-          const uint8_t* InstBytes = reinterpret_cast<const uint8_t*>(InstAddress);
+          const uint8_t* InstBytes = SyscallHandler->ResolveGuestCodePointer(InstAddress, DecodedInfo->InstSize, reinterpret_cast<const uint8_t*>(InstAddress));
+          if (!InstBytes) std::abort();
           ZydisDisassembledInstruction ZydisInst;
           if (ZYAN_SUCCESS(ZydisDisassembleIntel(ZydisMachineMode, InstAddress, InstBytes, DecodedInfo->InstSize, &ZydisInst))) {
             LogMan::Msg::IFmt("    {:#x}: {}", InstAddress, ZydisInst.text);
@@ -642,7 +643,8 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
         }
 
         if (Config.SMCChecks == FEXCore::Config::CONFIG_SMC_FULL || Block.ForceFullSMCDetection) {
-          auto ExistingCodePtr = reinterpret_cast<uint8_t*>(Block.Entry + BlockInstructionsLength);
+          auto ExistingCodePtr = SyscallHandler->ResolveGuestCodePointer(Block.Entry + BlockInstructionsLength, DecodedInfo->InstSize, reinterpret_cast<const uint8_t*>(Block.Entry + BlockInstructionsLength));
+          if (!ExistingCodePtr) std::abort();
           auto InstAddressReg = Thread->OpDispatcher->_EntrypointOffset(GPRSize, InstAddress - GuestRIP);
 
           auto Value = FEXCore::Utils::crc32(ExistingCodePtr, DecodedInfo->InstSize);
diff --git a/FEXCore/Source/Interface/Core/Frontend.cpp b/FEXCore/Source/Interface/Core/Frontend.cpp
index 78d5f1a..f03da3d 100644
--- a/FEXCore/Source/Interface/Core/Frontend.cpp
+++ b/FEXCore/Source/Interface/Core/Frontend.cpp
@@ -128,9 +128,11 @@ uint8_t Decoder::ReadByte() {
 }
 
 std::optional<uint8_t> Decoder::PeekByte(uint8_t Offset) {
-  uint64_t ByteAddress = reinterpret_cast<uint64_t>(InstStream.InstStream + InstructionSize + Offset);
+  uint64_t ByteAddress = reinterpret_cast<uint64_t>(InstStream.InstStream) + InstructionSize + Offset;
   if (CheckRangeExecutable(ByteAddress, 1)) {
-    return InstStream.AdjustedInstStream[InstructionSize + Offset];
+    const auto* Source = CTX->SyscallHandler->ResolveGuestCodePointer(ByteAddress, 1, reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(InstStream.AdjustedInstStream) + InstructionSize + Offset));
+    if (!Source) return std::nullopt;
+    return *Source;
   } else {
     return std::nullopt;
   }
@@ -140,11 +142,13 @@ std::pair<uint64_t, bool> Decoder::ReadData(uint8_t Size) {
   LOGMAN_THROW_A_FMT(Size != 0 && Size <= sizeof(uint64_t), "Unknown data size to read");
 
   uint64_t Res = 0;
-  uint64_t Address = reinterpret_cast<uint64_t>(InstStream.InstStream + InstructionSize);
+  uint64_t Address = reinterpret_cast<uint64_t>(InstStream.InstStream) + InstructionSize;
   LastFieldReadOffset = (uint8_t)InstructionSize;
   LastFieldReadSize = Size;
   if (CheckRangeExecutable(Address, Size)) {
-    std::memcpy(&Res, &InstStream.AdjustedInstStream[InstructionSize], Size);
+    const auto* Source = CTX->SyscallHandler->ResolveGuestCodePointer(Address, Size, reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(InstStream.AdjustedInstStream) + InstructionSize));
+    if (!Source) { HitNonExecutableRange = true; return {0, false}; }
+    std::memcpy(&Res, Source, Size);
   } else {
     HitNonExecutableRange = true;
     // See PeekByte, this specific case may cause some executable memory to read as 0 but it doesn't matter as the entire instruction will be rolled back anyway.
@@ -1361,14 +1365,14 @@ const Decoder::DecodeStream Decoder::AdjustAddrForSpecialRegion(const uint8_t* _
     // Offset 0x800: vgetcpu
     uint64_t Offset = RIP - VSyscall_Base;
     return DecodeStream {
-      .InstStream = _InstStream - EntryPoint + RIP,
+      .InstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(_InstStream) - EntryPoint + RIP),
       .AdjustedInstStream = VSyscallData + Offset,
     };
   }
 
   return DecodeStream {
-    .InstStream = _InstStream - EntryPoint + RIP,
-    .AdjustedInstStream = _InstStream - EntryPoint + RIP,
+    .InstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(_InstStream) - EntryPoint + RIP),
+    .AdjustedInstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(_InstStream) - EntryPoint + RIP),
   };
 }
 
diff --git a/FEXCore/Source/Interface/Core/Frontend.h b/FEXCore/Source/Interface/Core/Frontend.h
index 1fc0e6e..5ff61cd 100644
--- a/FEXCore/Source/Interface/Core/Frontend.h
+++ b/FEXCore/Source/Interface/Core/Frontend.h
@@ -162,14 +162,14 @@ private:
     const uint8_t* AdjustedInstStream;
 
     DecodeStream& operator-=(size_t offset) noexcept {
-      InstStream -= offset;
-      AdjustedInstStream -= offset;
+      InstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(InstStream) - offset);
+      AdjustedInstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(AdjustedInstStream) - offset);
       return *this;
     }
 
     DecodeStream& operator+=(size_t offset) noexcept {
-      InstStream += offset;
-      AdjustedInstStream += offset;
+      InstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(InstStream) + offset);
+      AdjustedInstStream = reinterpret_cast<const uint8_t*>(reinterpret_cast<uint64_t>(AdjustedInstStream) + offset);
       return *this;
     }
   };
diff --git a/FEXCore/include/FEXCore/HLE/SyscallHandler.h b/FEXCore/include/FEXCore/HLE/SyscallHandler.h
index 0ba0218..28cec0e 100644
--- a/FEXCore/include/FEXCore/HLE/SyscallHandler.h
+++ b/FEXCore/include/FEXCore/HLE/SyscallHandler.h
@@ -39,6 +39,12 @@ public:
   virtual ExecutableRangeInfo QueryGuestExecutableRange(FEXCore::Core::InternalThreadState* Thread, uint64_t Address) = 0;
   virtual std::optional<ExecutableFileSectionInfo> LookupExecutableFileSection(Core::InternalThreadState* Thread, uint64_t GuestAddr) = 0;
 
+  // Compile-only clients keep guest instruction bytes outside the guest VA:
+  // return the host bytes for [Address, Address+Size), or nullptr if not available.
+  virtual const uint8_t* ResolveGuestCodePointer(uint64_t Address, uint64_t Size, const uint8_t* Fallback) {
+    return Fallback;
+  }
+
   virtual void PreCompile() {}
 
   virtual SourcecodeResolver* GetSourcecodeResolver() {
