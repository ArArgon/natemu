From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Wed, 28 Oct 2026 00:00:00 +0000
Subject: [PATCH 11/11] FEXCore: slice1 code that touches no emulator data

Under fexc_slice1 only (the default profile is unchanged; FEX's own
BLOCK_DEBUGGING branch of ExitFunction is back to its upstream form). The
code makes no load or store but guest accesses: no x28 frame field, no
literal, no sp. The helpers are in tools/fexc/shim/fexc_sites.inc.

- BranchOps.cpp ExitFunction: a literal exit is InsertGuestRIPMove(x0, RIP)
  (a guest_rip_move relocation) then `svc #FEXC_SVC_LINK`, the resident's
  block linker, which rewrites the move's first word into a direct branch;
  a computed exit is `mov x0, xR` then FexcDispatchExit, a placeholder
  `b .` recorded in fexc_dispatch_exits (fexc exports it as a
  dispatch_branch relocation) that the resident relocates to its dispatcher.
  No State.rip store, no frame pointer load, no `br`.
- ALUOps.cpp Div/UDiv: the 128/64 division is `svc #FEXC_SVC_DIV_S/U`
  instead of FEX's LDIV/LUDIV helper call (no pointer load, no lr push on sp,
  no blr); FexcDivAfterCall then tests x2 as before.
- JIT.cpp EmitEntryPoint: no InlineJITBlockHeader store (the resident finds a
  block by its native PCs). EmitSuspendInterruptCheck: the stop check is a
  placeholder `bl .` the resident relocates to the vCPU's stop pad, a `ret`
  alone in its stage-2 granule (a kick removes execute permission from it),
  instead of the store to the interrupt fault page. x30 is dead there.
- RedundantFlagCalculationElimination.cpp: the pre-NZCV save is no longer an
  IR StoreContext to the frame; the pass records the instruction in
  fexc_pre_nzcv and the JIT emits `mrs x25, nzcv` at its start (x25 is the
  call-return stack pointer, unused under slice1, never allocated).
---
diff --git a/FEXCore/Source/Interface/Core/JIT/ALUOps.cpp b/FEXCore/Source/Interface/Core/JIT/ALUOps.cpp
index 8c2b3aa..197f243 100644
--- a/FEXCore/Source/Interface/Core/JIT/ALUOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/ALUOps.cpp
@@ -938,13 +938,16 @@ DEF_OP(Div) {
       mov(EmitSize, TMP2, Lower);
       mov(EmitSize, TMP3, Divisor);
 
-      ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.LDIVHandler));
-
-      str<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, -16);
-      blr(TMP4);
-      ldr<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, 16);
       if (fexc_slice1) {
-        FexcDivAfterCall(); // natemu: #DE reported by the resident helper
+        // natemu: the resident divides (x0-x2 in and out, nothing else changes) and reports #DE in x2.
+        svc(FEXC_SVC_DIV_S);
+        FexcDivAfterCall();
+      } else {
+        ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.LDIVHandler));
+
+        str<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, -16);
+        blr(TMP4);
+        ldr<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, 16);
       }
 
       // Move results to the destination registers
@@ -1024,13 +1027,16 @@ DEF_OP(UDiv) {
       mov(EmitSize, TMP2, Lower);
       mov(EmitSize, TMP3, Divisor);
 
-      ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.LUDIVHandler));
-
-      str<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, -16);
-      blr(TMP4);
-      ldr<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, 16);
       if (fexc_slice1) {
-        FexcDivAfterCall(); // natemu: #DE reported by the resident helper
+        // natemu: the resident divides (x0-x2 in and out, nothing else changes) and reports #DE in x2.
+        svc(FEXC_SVC_DIV_U);
+        FexcDivAfterCall();
+      } else {
+        ldr(TMP4, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.LUDIVHandler));
+
+        str<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, -16);
+        blr(TMP4);
+        ldr<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::lr, ARMEmitter::Reg::rsp, 16);
       }
 
       // Move results to the destination registers
diff --git a/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp b/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
index 91ad3e7..d198d41 100644
--- a/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/BranchOps.cpp
@@ -56,7 +56,25 @@ DEF_OP(ExitFunction) {
 
   uint64_t NewRIP;
 
-  if (fexc_slice1 || Context::BLOCK_DEBUGGING) {
+  if (fexc_slice1) {
+    // natemu slice1: exits touch no emulator data. A literal exit moves its RIP into x0 and enters the resident's block
+    // linker with `svc` (the resident then rewrites the move's first word into a direct branch to the target's entry);
+    // a computed exit moves its RIP into x0 and branches to the resident's dispatcher, a `b` the resident relocates when
+    // it places the block (FexcDispatchExit records it).
+    if (IsInlineConstant(Op->NewRIP, &NewRIP) || IsInlineEntrypointOffset(Op->NewRIP, &NewRIP)) {
+      InsertGuestRIPMove(TMP1, NewRIP);
+      svc(FEXC_SVC_LINK);
+    } else {
+      const auto RipReg = GetReg(Op->NewRIP);
+      if (RipReg.Idx() != TMP1.Idx()) {
+        mov(ARMEmitter::Size::i64Bit, TMP1, RipReg.X());
+      }
+      FexcDispatchExit();
+    }
+    return;
+  }
+
+  if constexpr (Context::BLOCK_DEBUGGING) {
     // Skip block linking when BLOCK_DEBUGGING as it adds overhead and is unncessary.
     // This is a debug only feature and doesn't need caching help.
     bool IsInlineRIP = IsInlineConstant(Op->NewRIP, &NewRIP) || IsInlineEntrypointOffset(Op->NewRIP, &NewRIP);
@@ -68,18 +86,12 @@ DEF_OP(ExitFunction) {
       auto RipReg = GetReg(Op->NewRIP);
       str(RipReg.X(), STATE, offsetof(FEXCore::Core::CpuStateFrame, State.rip));
     }
-    // natemu slice1: a literal exit goes through FEX's block linker pointer (the resident links it, patching the
-    // `ldr` into a direct branch), a computed one through the dispatcher.
-    if (fexc_slice1 && IsInlineRIP) {
-      ldr(TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.ExitFunctionLinker));
-    } else {
-      ldr(TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.DispatcherLoopTop));
-    }
+    ldr(TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.DispatcherLoopTop));
     br(TMP2);
 
     if (IsInlineRIP) {
       BindOrRestart(&l_ExitLink);
-      PlaceNamedSymbolLiteral(InsertGuestRIPLiteral(NewRIP));
+      dc64(NewRIP);
     }
 
     return;
diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index 99cf371..fac2b66 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -802,7 +802,14 @@ void Arm64JITCore::EmitTFCheck() {
 }
 
 void Arm64JITCore::EmitSuspendInterruptCheck() {
-  if (CTX->Config.NeedsPendingInterruptFaultCheck || fexc_slice1) { // natemu slice1: the runtime stops a vCPU by protecting this page
+  if (fexc_slice1) {
+    // natemu slice1: `bl` to the vCPU's stop pad (a `ret` alone in its stage-2 granule), relocated by the resident when it
+    // places the block. A kick removes execute permission from the pad, so the next block entry stops precisely there.
+    // x30 is an RA temporary, dead at a block entry.
+    dc32(0x94000000);
+    return;
+  }
+  if (CTX->Config.NeedsPendingInterruptFaultCheck) {
     // Trigger a fault if there are any pending interrupts
     // Used only for gdbserver at the moment
     constexpr size_t InterruptPageOffset =
@@ -830,8 +837,10 @@ void Arm64JITCore::EmitSuspendInterruptCheck() {
 void Arm64JITCore::EmitEntryPoint(ARMEmitter::BackwardLabel& HeaderLabel, bool CheckTF) {
   // Get the address of the JITCodeHeader and store in to the core state.
   // Two instruction cost, each 1 cycle.
-  adr_OrRestart(TMP1, &HeaderLabel);
-  str(TMP1, STATE, offsetof(FEXCore::Core::CPUState, InlineJITBlockHeader));
+  if (!fexc_slice1) { // natemu slice1: no header store; the resident finds a block by its native PCs
+    adr_OrRestart(TMP1, &HeaderLabel);
+    str(TMP1, STATE, offsetof(FEXCore::Core::CPUState, InlineJITBlockHeader));
+  }
 
   if (CheckTF) {
     EmitTFCheck();
@@ -910,6 +919,7 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
   fexc_insns.clear();
   DebugData->FexcEntryPrologues.clear();
   FexcGuest = FexcInsnNative = 0; FexcCf = true; FexcNzcvWritten = FexcNzcvSaved = FexcStoreSeen = false; FexcLoadSite = -1; FexcPendingFused.clear();
+  fexc_dispatch_exits.clear();
   FexcStubs.clear(); FexcPendingLink.clear(); FexcTargetsDone = 0;
   DebugData->GuestOpcodes.clear(); DebugData->Subblocks.clear();   // natemu: per attempt (a far-branch restart re-emits them)
   JumpTargets.clear();
diff --git a/FEXCore/Source/Interface/Core/JIT/JITClass.h b/FEXCore/Source/Interface/Core/JIT/JITClass.h
index 71a3eab..8a29e03 100644
--- a/FEXCore/Source/Interface/Core/JIT/JITClass.h
+++ b/FEXCore/Source/Interface/Core/JIT/JITClass.h
@@ -548,6 +548,8 @@ private:
   // natemu (fexc), profile slice1: div/idiv #DE checks before the divide op and after FEX's LUDIV/LDIV call (same file).
   void FexcDivCheck(const IR::IROp_Header* IROp);
   void FexcDivAfterCall();
+  // natemu (fexc), profile slice1: a computed exit's branch to the resident's dispatcher (same file).
+  void FexcDispatchExit();
   // (targets and RIP-relative accesses come from FexcPrecision::Prescan, run before register allocation)
   fextl::map<size_t, ARMEmitter::ForwardLabel> FexcStubs;   // guard/split site index -> its stub
   fextl::vector<size_t> FexcPendingLink;                    // guard/split sites waiting for their access's native offset
diff --git a/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp b/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp
index d6137cb..f749818 100644
--- a/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp
+++ b/FEXCore/Source/Interface/IR/Passes/RedundantFlagCalculationElimination.cpp
@@ -706,19 +706,20 @@ void DeadFlagCalculationEliminination::Run(IREmitter* IREmit) {
   fextl::deque<uint32_t> Worklist;
 
   if (fexc_slice1) {
+    fexc_pre_nzcv.clear();
     Ref Guest = nullptr;
+    uint64_t GuestOffset = 0;
     bool Writer = false, Saved = false;
     for (auto [BlockNode, BlockHeader] : CurrentIR.GetBlocks()) {
       for (auto [CodeNode, IROp] : CurrentIR.GetCode(BlockNode)) {
         if (IROp->Op == OP_GUESTOPCODE) {
           Guest = CodeNode;
+          GuestOffset = IROp->C<IROp_GuestOpcode>()->GuestEntryOffset;
           Writer = Saved = false;
         } else if (FexcPrecision::FaultPoint(IROp->Op)) {
           if (Writer && !Saved && Guest) {
-            auto Cursor = IREmit->GetWriteCursor();
-            IREmit->SetWriteCursor(Guest);
-            IREmit->_StoreContext(OpSize::i32Bit, RegClass::GPR, IREmit->_LoadNZCV(), FexcPrecision::PreNzcvOffset);
-            IREmit->SetWriteCursor(Cursor);
+            // The JIT saves the incoming NZCV in a register at the instruction start (shim/fexc_sites.inc).
+            fexc_pre_nzcv.insert(GuestOffset);
             Saved = true;
           }
         } else if (IROp->Op != OP_INVALIDATEFLAGS && ((Classify(IROp).Write() & FLAG_NZCV) || IR::ImplicitFlagClobber(IROp->Op))) {
