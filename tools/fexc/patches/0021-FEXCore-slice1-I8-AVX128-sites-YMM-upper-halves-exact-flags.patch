From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH 21/21] FEXCore: slice1 I8 AVX128 sites, YMM upper halves, exact
 flags

Under fexc_slice1 only (FEX's AVX128 lowering: no SVE256 on the M4).

- OpcodeDispatcher.h FlushRegisterCache(SRAOnly): the YMM upper halves
  (avx_high) are flushed per instruction like the static registers, so no
  write is dropped (VZEROUPPER's invalidation) or sunk past a later fault.
- OpcodeDispatcher.h _LoadMemPairAutoTSO/_StoreMemPairAutoTSO: an FS/GS-based
  32-byte operand is one LDP/STP too (one store site, no partial update).
- AVX_128.cpp: VMOVAPS/VMOVAPD/VMOVDQA VEX.128 m128 as one aligned LDP/STP of
  two X registers (SDM Vol.3 9.1.1, as patch 0018); VMOVNT* and VMOVNTDQA as
  plain accesses (32 bytes: one pair); element loads/stores through
  FexcLoadElement/FexcStoreElement; VBROADCAST* from memory as a plain element
  load and a duplicate; VFMADDSUB/VFMSUBADD negate the addend with fneg (a
  NaN keeps its sign under FPCR.AH = 1) instead of an XOR of the sign bit.
- Vector.cpp VFCMPOpImpl/InsertScalarFCMPOpImpl: the AVX predicates 8..31
  with x86's MXCSR flags (quiet predicates raise IE only for an SNaN, the
  signalling ones for a QNaN too; FALSE/TRUE compare as well).
---
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
index dda20cf..544c250 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher.h
@@ -1207,7 +1207,10 @@ public:
 
       // natemu (fexc_slice1): DF is guest state the resident banks at a fault (the guest-state page), so cld/std store it
       // in their own instruction like a static register, never sunk to the block end or merged with a later write.
-      Mask &= (GPRMask | FPRMask | (fexc_slice1 ? 1ull << DFIndex : 0));
+      // natemu (fexc_slice1, I8): likewise the YMM upper halves (avx_high, the resident's XSAVE component 2 and the state a
+      // fault reports): each instruction stores the ones it wrote, so no write is dropped (VZEROUPPER's invalidation) or sunk.
+      const uint64_t AVXHighMask = ((1ull << (AVXHigh15Index - AVXHigh0Index + 1)) - 1) << AVXHigh0Index;
+      Mask &= (GPRMask | FPRMask | (fexc_slice1 ? (1ull << DFIndex) | AVXHighMask : 0));
       Bits &= Mask;
     }
 
@@ -1448,7 +1451,7 @@ private:
   void MOVScalarOpImpl(OpcodeArgs, IR::OpSize ElementSize);
   void VMOVScalarOpImpl(OpcodeArgs, IR::OpSize ElementSize);
 
-  Ref VFCMPOpImpl(OpSize Size, IR::OpSize ElementSize, Ref Src1, Ref Src2, uint8_t CompType);
+  Ref VFCMPOpImpl(OpSize Size, IR::OpSize ElementSize, Ref Src1, Ref Src2, uint8_t CompType, bool FexcInner = false);
 
   void VTESTOpImpl(OpSize SrcSize, IR::OpSize ElementSize, Ref Src1, Ref Src2);
 
@@ -2567,8 +2570,9 @@ private:
   RefPair _LoadMemPairAutoTSO(RegClass Class, OpSize Size, const AddressMode& A, OpSize Align = OpSize::i8Bit) {
     const bool AtomicTSO = IsTSOEnabled(Class) && !A.NonTSO;
 
-    // Use ldp if possible, otherwise fallback on two loads.
-    if (!AtomicTSO && !A.Segment && Size >= OpSize::i32Bit && Size <= OpSize::i128Bit) {
+    // Use ldp if possible, otherwise fallback on two loads. natemu slice1 (I8): with an FS/GS base too (SelectPairAddressMode
+    // adds it), so a 32-byte operand is always one access.
+    if (!AtomicTSO && (!A.Segment || fexc_slice1) && Size >= OpSize::i32Bit && Size <= OpSize::i128Bit) {
       const auto B = SelectPairAddressMode(A, Size);
       return LoadMemPair(Class, Size, B.Base, B.Offset);
     }
@@ -2606,8 +2610,8 @@ private:
     const auto SizeInt = IR::OpSizeToSize(Size);
     const bool AtomicTSO = IsTSOEnabled(Class) && !A.NonTSO;
 
-    // Use stp if possible, otherwise fallback on two stores.
-    if (!AtomicTSO && !A.Segment && Size >= OpSize::i32Bit && Size <= OpSize::i128Bit) {
+    // Use stp if possible, otherwise fallback on two stores. natemu slice1 (I8): with an FS/GS base too (one store site).
+    if (!AtomicTSO && (!A.Segment || fexc_slice1) && Size >= OpSize::i32Bit && Size <= OpSize::i128Bit) {
       const auto B = SelectPairAddressMode(A, Size);
       _StoreMemPair(Class, Size, Value1, Value2, B.Base, B.Offset);
     } else {
diff --git a/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp b/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
index 59466b9..6fa6893 100644
--- a/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
+++ b/FEXCore/Source/Interface/Core/OpcodeDispatcher/AVX_128.cpp
@@ -132,6 +132,21 @@ void OpDispatchBuilder::AVX128_VMOVAPS(OpcodeArgs) {
   const auto SrcSize = GetSrcSize(Op);
   const auto Is128Bit = SrcSize == Core::CPUState::XMM_SSE_REG_SIZE;
 
+  if (Is128Bit && fexc_slice1 && fexc_align16.count(Op->PC) && !(Op->Dest.IsGPR() && Op->Src[0].IsGPR())) {
+    // natemu slice1 (I8): VMOVAPS/VMOVAPD/VMOVDQA VEX.128 with a memory operand are single-copy atomic on processors that
+    // enumerate AVX (SDM Vol.3 9.1.1), as MOVAPS (patch 0018): one 16-byte aligned LDP/STP of two X registers (FEAT_LSE2),
+    // its alignment checked first (#GP(0); fexc_align16 holds exactly the aligned forms here).
+    if (!Op->Dest.IsGPR()) {
+      auto Src = AVX128_LoadSource_WithOpSize(Op, Op->Src[0], Op->Flags, false);
