From: natemu <natemu@example.invalid>
Date: Tue, 27 Oct 2026 00:00:00 +0000
Subject: [PATCH 4/6] FEXCore: record guest memory access sites

The hooks behind the natemu-fexc-v2 `sites` array. The dispatcher's
carry-inversion state is captured where each GuestOpcode op is created
(OpcodeDispatcher::FexcCFInverted, fexc_cf_inverted in Core.cpp). The JIT
calls Arm64JITCore::FexcAfterOp after every emitted IR op (declared in
JITClass.h, defined in tools/fexc/shim/fexc_sites.inc which MemoryOps.cpp
includes), resets the recorder state on each (re)emission attempt, and
keeps the spill size. No behaviour change to the generated code.
---
 FEXCore/Source/Interface/Core/Core.cpp           | 1 +
 FEXCore/Source/Interface/Core/JIT/JIT.cpp        | 8 ++++++++
 FEXCore/Source/Interface/Core/JIT/JITClass.h     | 7 +++++++
 FEXCore/Source/Interface/Core/JIT/MemoryOps.cpp  | 4 ++++
 FEXCore/Source/Interface/Core/OpcodeDispatcher.h | 2 ++
 5 files changed, 22 insertions(+)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 518576f..b0c645f 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -640,6 +640,7 @@ ContextImpl::GenerateIR(FEXCore::Core::InternalThreadState* Thread, uint64_t Gue
         Thread->OpDispatcher->FlushRegisterCache(true);
 
         if (ExtendedDebugInfo || Thread->OpDispatcher->CanHaveSideEffects(TableInfo, DecodedInfo)) {
+          fexc_cf_inverted[InstAddress - GuestRIP] = Thread->OpDispatcher->FexcCFInverted();
           Thread->OpDispatcher->_GuestOpcode(InstAddress - GuestRIP);
         }
 
diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index 3e52fe9..a9082e0 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -1,3 +1,4 @@
+#include <fexc_hook.h>
 // SPDX-License-Identifier: MIT
 /*
 $info$
@@ -905,6 +906,10 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
   }
 
   uint32_t SSACount = IR->GetSSACount();
+  fexc_sites.clear();
+  fexc_insns.clear();
+  DebugData->FexcEntryPrologues.clear();
+  FexcGuest = FexcInsnNative = 0; FexcCf = true; FexcNzcvWritten = FexcNzcvSaved = FexcStoreSeen = false; FexcLoadSite = -1; FexcPendingFused.clear();
   JumpTargets.clear();
   CallReturnTargets.clear();
   PendingJumpThunks.clear();
@@ -1016,6 +1021,7 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
     }
 
     for (auto [CodeNode, IROp] : IR->GetCode(BlockNode)) {
+      const uint32_t FexcBegin = uint32_t(GetCursorAddress<uint8_t*>() - CodeData.BlockBegin);
       switch (IROp->Op) {
 #define REGISTER_OP(op, x) \
   case FEXCore::IR::IROps::OP_##op: Op_##x(IROp, CodeNode); break
@@ -1026,6 +1032,7 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
 
       default: Op_Unhandled(IROp, CodeNode); break;
       }
+      FexcAfterOp(IROp, CodeNode, FexcBegin);
     }
 
     DebugData->Subblocks.push_back({static_cast<uint32_t>(BlockStartHostCode - CodeData.BlockBegin),
@@ -1194,6 +1201,7 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
 #endif
 
   DebugData->HostCodeSize = CodeData.Size;
+  fexc_spill_bytes = uint32_t(SpillSlots * MaxSpillSlotSize);
   DebugData->FexcSRAGPRCount = uint8_t(StaticRegisters.size());
   for (size_t i = 0; i < StaticRegisters.size(); ++i) DebugData->FexcSRAGPR[i] = uint8_t(StaticRegisters[i].Idx());
   DebugData->FexcSRAFPRCount = uint8_t(StaticFPRegisters.size());
