From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: natemu <natemu@example.invalid>
Date: Tue, 27 Oct 2026 00:00:00 +0000
Subject: [PATCH 3/7] FEXCore: compile-only export hook and extra debug data

Include tools/fexc/shim/fexc_hook.h in Core.cpp; call
fexc_compile_hook with the finished native code and FEX's DebugData from
ContextImpl::CompileCode, before the block is installed, and request the
dense guest-opcode table when fexc_dense_pc_table is set.

DebugData gains the entry-prologue end offsets (recorded in JIT.cpp at
each EmitEntryPoint) and the static register maps used for the compile.
---
 FEXCore/Source/Interface/Core/Core.cpp        | 7 ++++++-
 FEXCore/Source/Interface/Core/JIT/DebugData.h | 9 +++++++++
 FEXCore/Source/Interface/Core/JIT/JIT.cpp     | 5 +++++
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/FEXCore/Source/Interface/Core/Core.cpp b/FEXCore/Source/Interface/Core/Core.cpp
index 46c0d30..518576f 100644
--- a/FEXCore/Source/Interface/Core/Core.cpp
+++ b/FEXCore/Source/Interface/Core/Core.cpp
@@ -1,3 +1,4 @@
+#include <fexc_hook.h>
 // SPDX-License-Identifier: MIT
 /*
 $info$
@@ -803,7 +804,7 @@ ContextImpl::CompileCodeResult ContextImpl::CompileCode(FEXCore::Core::InternalT
 
   // Generate IR + Meta Info
   auto [IRView, TotalInstructions, TotalInstructionsLength, StartAddr, Length, NeedsAddGuestCodeRanges] =
-    GenerateIR(Thread, GuestRIP, Config.GDBSymbols(), MaxInst);
+    GenerateIR(Thread, GuestRIP, Config.GDBSymbols() || fexc_dense_pc_table, MaxInst);
   if (!IRView) {
     Thread->FrontendDecoder->ValidateDisownedOrFree();
     Thread->OpDispatcher->ValidateDisownedOrFree();
@@ -836,6 +837,10 @@ ContextImpl::CompileCodeResult ContextImpl::CompileCode(FEXCore::Core::InternalT
   bool TFSet = Thread->CurrentFrame->State.flags[X86State::RFLAG_TF_RAW_LOC];
 
   auto CompiledCode = Thread->CPUBackend->CompileCode(GuestRIP, Length, TotalInstructions == 1, &*IRView, DebugData.get(), TFSet);
+  if (fexc_compile_hook) {
+    fexc_compile_hook(Thread, FexcCompileInfo {GuestRIP, StartAddr, Length, TotalInstructions, TotalInstructionsLength},
+                      CompiledCode.BlockBegin, CompiledCode.Size, *DebugData);
+  }
 
   // Release the IR
   Thread->OpDispatcher->DelayedDisownBuffer();
diff --git a/FEXCore/Source/Interface/Core/JIT/DebugData.h b/FEXCore/Source/Interface/Core/JIT/DebugData.h
index ffbd9f7..486b432 100644
--- a/FEXCore/Source/Interface/Core/JIT/DebugData.h
+++ b/FEXCore/Source/Interface/Core/JIT/DebugData.h
@@ -5,6 +5,7 @@
 #include <FEXCore/fextl/vector.h>
 
 #include <cstdint>
+#include <utility>
 
 namespace FEXCore::CPU {
 union Relocation;
@@ -31,5 +32,13 @@ struct DebugData : public FEXCore::Allocator::FEXAllocOperators {
   fextl::vector<DebugDataSubblock> Subblocks;
   fextl::vector<DebugDataGuestOpcode> GuestOpcodes;
   fextl::vector<FEXCore::CPU::Relocation>* Relocations;
+
+  // natemu additions: {guest entry offset, native offset where the entry prologue ends}
+  // for every FEX entry point, and the static register map used for this compile.
+  fextl::vector<std::pair<uint64_t, uint64_t>> FexcEntryPrologues;
+  uint8_t FexcSRAGPR[18] {};
+  uint8_t FexcSRAGPRCount {};
+  uint8_t FexcSRAFPR[16] {};
+  uint8_t FexcSRAFPRCount {};
 };
 } // namespace FEXCore::Core
diff --git a/FEXCore/Source/Interface/Core/JIT/JIT.cpp b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
index dfef604..3e52fe9 100644
--- a/FEXCore/Source/Interface/Core/JIT/JIT.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/JIT.cpp
@@ -1002,6 +1002,7 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
         DebugData->GuestOpcodes.push_back({BlockIROp->GuestEntryOffset, GetCursorAddress<uint8_t*>() - CodeData.BlockBegin});
 
         EmitEntryPoint(JITCodeHeaderLabel, CheckTF);
+        DebugData->FexcEntryPrologues.push_back({BlockIROp->GuestEntryOffset, uint64_t(GetCursorAddress<uint8_t*>() - CodeData.BlockBegin)});
       }
 
       if (PendingCallReturnTargetLabel) {
@@ -1193,6 +1194,10 @@ CPUBackend::CompiledCode Arm64JITCore::CompileCode(uint64_t Entry, uint64_t Size
 #endif
 
   DebugData->HostCodeSize = CodeData.Size;
+  DebugData->FexcSRAGPRCount = uint8_t(StaticRegisters.size());
+  for (size_t i = 0; i < StaticRegisters.size(); ++i) DebugData->FexcSRAGPR[i] = uint8_t(StaticRegisters[i].Idx());
+  DebugData->FexcSRAFPRCount = uint8_t(StaticFPRegisters.size());
+  for (size_t i = 0; i < StaticFPRegisters.size(); ++i) DebugData->FexcSRAFPR[i] = uint8_t(StaticFPRegisters[i].Idx());
   DebugData->Relocations = &Relocations;
 
   this->IR = nullptr;
