#!/bin/sh
# mix: 32-bit and 64-bit programs running at the same time (the code identity, the lookup tables and the x87 state
# across context switches between the two modes): each program's output under load is its output alone.
D=${0%/*}
py='print(sum(i * i for i in range(200000)), 2.0 ** 0.5, sum(1 / i for i in range(1, 20000)))'
"$D/x87.static" > x87.ref; "$D/x87.dyn" > x87d.ref; "$D/threads.dyn" > thr.ref; "$D/signals.static" > sig.ref
python3 -c "$py" > py.ref; seq 1 100000 | sha256sum > sha.ref
for r in 1 2 3; do
    "$D/x87.static" > x87.$r & "$D/x87.dyn" > x87d.$r & "$D/threads.dyn" > thr.$r & "$D/signals.static" > sig.$r &
    python3 -c "$py" > py.$r & seq 1 100000 | sha256sum > sha.$r & wait
    for f in x87 x87d thr sig py sha; do cmp -s $f.ref $f.$r && echo "round $r $f same" || echo "round $r $f DIFFERS"; done
done
