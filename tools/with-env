#!/bin/sh
# Supply project defaults to every child tool, including the frozen runners.
set -eu
if [ "$#" -eq 0 ]; then
    echo "Usage: tools/with-env COMMAND [ARG ...]" >&2
    exit 2
fi
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
# Default: natemu-raw beside the main checkout, also from inside a worktree (git's common dir is the main checkout's .git).
if [ -z "${NATEMU_RAW_ROOT:-}" ]; then
    if common=$(git -C "$project_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
        NATEMU_RAW_ROOT=$(dirname "$(dirname "$common")")/natemu-raw
    else
        NATEMU_RAW_ROOT=$project_root/../natemu-raw
    fi
fi
export NATEMU_RAW_ROOT
exec "$@"
